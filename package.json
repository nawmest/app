{
  "name": "pulselens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AR health check in the browser: scans your face with the front camera and measures heart rate, breathing and HRV from subtle skin colour changes (rPPG).",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@mediapipe/tasks-vision": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
